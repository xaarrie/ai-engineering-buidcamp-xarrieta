<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Microsoft.Agents.AI.Abstractions</id>
    <version>1.22.0</version>
    <title>Microsoft Agent Framework Abstractions</title>
    <authors>Microsoft</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>NUGET.md</readme>
    <projectUrl>https://learn.microsoft.com/agent-framework/</projectUrl>
    <description>Provides Microsoft Agent Framework interfaces and abstractions.</description>
    <copyright>© Microsoft Corporation. All rights reserved.</copyright>
    <tags>AI, Artificial Intelligence, Agent, SDK, Framework</tags>
    <repository type="git" url="https://github.com/microsoft/agent-framework" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Extensions.AI.Abstractions" version="10.10.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="Microsoft.Extensions.AI.Abstractions" version="10.10.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.6.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.Extensions.AI.Abstractions" version="10.10.0" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="10.0.12" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Microsoft.Extensions.AI.Abstractions" version="10.10.0" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="10.0.12" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Extensions.AI.Abstractions" version="10.10.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>